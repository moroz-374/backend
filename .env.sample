# Remnawave Traffic Audit production environment.
# Download this file as `.env`, set the three domain values, then generate secrets:
# jwt_auth=$(openssl rand -hex 64); jwt_api=$(openssl rand -hex 64); metrics=$(openssl rand -hex 32); webhook=$(openssl rand -hex 32); postgres=$(openssl rand -hex 32); clickhouse=$(openssl rand -hex 32); sed -i "s/^JWT_AUTH_SECRET=.*/JWT_AUTH_SECRET=$jwt_auth/; s/^JWT_API_TOKENS_SECRET=.*/JWT_API_TOKENS_SECRET=$jwt_api/; s/^METRICS_PASS=.*/METRICS_PASS=$metrics/; s/^WEBHOOK_SECRET_HEADER=.*/WEBHOOK_SECRET_HEADER=$webhook/; s/^POSTGRES_PASSWORD=.*/POSTGRES_PASSWORD=$postgres/; s/^TRAFFIC_AUDIT_CLICKHOUSE_PASSWORD=.*/TRAFFIC_AUDIT_CLICKHOUSE_PASSWORD=$clickhouse/" .env; unset jwt_auth jwt_api metrics webhook postgres clickhouse
# Automated install/upgrade: scripts/panel-installer.sh (see docs/panel-install-upgrade.md)
# Manual validation: docker compose config --quiet
# Manual start: docker compose up -d

### IMAGE ###
REMNAWAVE_VERSION=2.7.4-traffic-audit.1

### PORTS (published on 127.0.0.1 only) ###
APP_PORT=3000
METRICS_PORT=3001

### API ###
# max = all cores; -1 = all cores minus one; or an explicit positive number.
API_INSTANCES=1

### DOMAINS (required; domain only, without scheme or trailing slash) ###
PANEL_DOMAIN=
FRONT_END_DOMAIN=
SUB_PUBLIC_DOMAIN=

### AUTHENTICATION (required; generated by the command above) ###
JWT_AUTH_SECRET=
JWT_API_TOKENS_SECRET=
JWT_AUTH_LIFETIME=12

### POSTGRESQL (internal only) ###
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

### VALKEY (internal Unix socket only) ###
REDIS_SOCKET=/var/run/valkey/valkey.sock
REDIS_DB=1

### CLICKHOUSE (internal only) ###
TRAFFIC_AUDIT_CLICKHOUSE_USER=remnawave
TRAFFIC_AUDIT_CLICKHOUSE_PASSWORD=
TRAFFIC_AUDIT_CLICKHOUSE_DATABASE=remnawave
TRAFFIC_AUDIT_RETENTION_DAYS=30

### PROMETHEUS (published on 127.0.0.1 only) ###
METRICS_USER=admin
METRICS_PASS=

### WEBHOOKS ###
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET_HEADER=

### OPTIONAL TELEGRAM NOTIFICATIONS ###
IS_TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_USERS=
TELEGRAM_NOTIFY_NODES=
TELEGRAM_NOTIFY_CRM=
TELEGRAM_NOTIFY_SERVICE=
TELEGRAM_NOTIFY_TBLOCKER=

### OPTIONAL API DOCUMENTATION ###
IS_DOCS_ENABLED=false
SWAGGER_PATH=/docs
SCALAR_PATH=/scalar

### OPTIONAL SERVICE SETTINGS ###
BANDWIDTH_USAGE_NOTIFICATIONS_ENABLED=false
BANDWIDTH_USAGE_NOTIFICATIONS_THRESHOLD=[60, 80]
NOT_CONNECTED_USERS_NOTIFICATIONS_ENABLED=false
NOT_CONNECTED_USERS_NOTIFICATIONS_AFTER_HOURS=[6, 24, 48]

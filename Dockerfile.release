# syntax=docker/dockerfile:1

FROM --platform=$BUILDPLATFORM node:24.14-alpine AS frontend-build
WORKDIR /opt/frontend

COPY --from=frontend-source package*.json ./
RUN npm ci --legacy-peer-deps

COPY --from=frontend-source . .
RUN npm run start:build \
    && apk add --no-cache curl ca-certificates \
    && mkdir -p dist/assets \
    && curl -fsSL https://validator.remna.dev/wasm_exec.js -o dist/assets/wasm_exec.js \
    && curl -fsSL https://validator.remna.dev/xray.schema.json -o dist/assets/xray.schema.json \
    && curl -fsSL https://validator.remna.dev/xray.schema.cn.json -o dist/assets/xray.schema.cn.json \
    && curl -fsSL https://validator.remna.dev/main.wasm -o dist/assets/main.wasm

FROM node:24.14-trixie-slim AS backend-build
WORKDIR /opt/app

ENV PRISMA_CLI_BINARY_TARGETS=debian-openssl-3.0.x,linux-arm64-openssl-3.0.x

COPY package*.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./prisma.config.ts
COPY patches ./patches
RUN npm ci

COPY . .
RUN npm run migrate:generate \
    && npm run build \
    && npm run test:traffic-audit \
    && npm prune --omit=dev \
    && npm cache clean --force

FROM node:24.14-trixie-slim
WORKDIR /opt/app

ARG BRANCH=main
ARG __RW_METADATA_VERSION
ARG __RW_METADATA_GIT_BACKEND_COMMIT
ARG __RW_METADATA_GIT_FRONTEND_COMMIT
ARG __RW_METADATA_GIT_BRANCH
ARG __RW_METADATA_BUILD_TIME
ARG __RW_METADATA_BUILD_NUMBER=0

LABEL org.opencontainers.image.title="Remnawave" \
    org.opencontainers.image.description="Remnawave backend with locally built traffic-audit frontend" \
    org.opencontainers.image.url="https://github.com/moroz-374/backend" \
    org.opencontainers.image.source="https://github.com/moroz-374/backend" \
    org.opencontainers.image.vendor="Remnawave" \
    org.opencontainers.image.licenses="AGPL-3.0-only" \
    org.opencontainers.image.documentation="https://docs.rw" \
    org.opencontainers.image.version=$__RW_METADATA_VERSION \
    org.opencontainers.image.revision=$__RW_METADATA_GIT_BACKEND_COMMIT \
    io.remnawave.frontend.source="https://github.com/moroz-374/frontend" \
    io.remnawave.frontend.revision=$__RW_METADATA_GIT_FRONTEND_COMMIT

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g pm2

ENV NODE_ENV=production \
    REMNAWAVE_BRANCH=${BRANCH} \
    PRISMA_HIDE_UPDATE_MESSAGE=true \
    PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1 \
    PM2_DISABLE_VERSION_CHECK=true \
    NODE_OPTIONS=--max-old-space-size=16384 \
    __RW_METADATA_VERSION=${__RW_METADATA_VERSION} \
    __RW_METADATA_GIT_BACKEND_COMMIT=${__RW_METADATA_GIT_BACKEND_COMMIT} \
    __RW_METADATA_GIT_FRONTEND_COMMIT=${__RW_METADATA_GIT_FRONTEND_COMMIT} \
    __RW_METADATA_GIT_BRANCH=${__RW_METADATA_GIT_BRANCH} \
    __RW_METADATA_BUILD_TIME=${__RW_METADATA_BUILD_TIME} \
    __RW_METADATA_BUILD_NUMBER=${__RW_METADATA_BUILD_NUMBER}

COPY --from=backend-build /opt/app/dist ./dist
COPY --from=frontend-build /opt/frontend/dist ./frontend
COPY --from=backend-build /opt/app/prisma ./prisma
COPY --from=backend-build /opt/app/patches ./patches
COPY --from=backend-build /opt/app/node_modules ./node_modules
COPY configs /var/lib/remnawave/configs
COPY package*.json ./
COPY prisma.config.ts ./prisma.config.ts
COPY libs ./libs
COPY ecosystem.config.js docker-entrypoint.sh ./

RUN sed -i 's/\r$//' docker-entrypoint.sh \
    && npm link

ENTRYPOINT ["/bin/sh", "docker-entrypoint.sh"]
CMD ["pm2-runtime", "start", "ecosystem.config.js", "--env", "production"]

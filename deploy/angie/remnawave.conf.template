map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream remnawave_backend {
    server remnawave:3000;
    keepalive 32;
}

resolver 127.0.0.11 ipv6=off;

acme_client remnawave https://acme-v02.api.letsencrypt.org/directory
    email={{ .Env.ACME_EMAIL }}
    key_type=rsa
    key_bits=2048
    challenge=http;

server {
    listen 80;
    listen [::]:80;
    server_name {{ .Env.PANEL_DOMAIN }} {{ .Env.SUB_PUBLIC_DOMAIN }};

    access_log off;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ .Env.PANEL_DOMAIN }} {{ .Env.SUB_PUBLIC_DOMAIN }};

    acme remnawave;
    ssl_certificate $acme_cert_remnawave;
    ssl_certificate_key $acme_cert_key_remnawave;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 10m;
    access_log off;

    location / {
        proxy_pass http://remnawave_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
